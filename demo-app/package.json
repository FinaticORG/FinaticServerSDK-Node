{
  "name": "@finatic/server-node-demo",
  "version": "1.0.0",
  "description": "Demo application for Finatic Server SDK Node.js",
  "main": "dist/index.js",
  "dependencies": {
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "inquirer": "^13.0.2"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --tsconfig tsconfig.json src/index.ts",
    "clean": "rimraf dist",
    "api:build": "tsc",
    "api:start": "node dist/api-server.js",
    "api:dev": "tsx --tsconfig tsconfig.json src/api-server.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^24.5.0",
    "rimraf": "^6.1.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "finatic",
    "trading",
    "api",
    "demo"
  ],
  "author": "Finatic",
  "license": "MIT",
  "packageManager": "yarn@4.9.4",
  "type": "module"
}
