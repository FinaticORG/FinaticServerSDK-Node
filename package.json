{
  "name": "@finatic/server-node",
  "version": "0.1.0",
  "description": "Node.js SDK for Finatic Server API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:validate": "node scripts/validate-docs.js",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "demo:build": "cd demo-app && yarn build",
    "demo:start": "cd demo-app && yarn start",
    "demo:dev": "cd demo-app && yarn dev",
    "demo:install": "yarn install",
    "dev": "concurrently \"yarn build:watch\" \"yarn demo:dev\"",
    "demo": "yarn build && cd demo-app && yarn dev"
  },
  "keywords": [
    "finatic",
    "trading",
    "finance",
    "api",
    "sdk",
    "nodejs",
    "typescript"
  ],
  "author": "Finatic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FinaticORG/FinaticServerSDK-Node.git"
  },
  "bugs": {
    "url": "https://github.com/FinaticORG/FinaticServerSDK-Node/issues"
  },
  "homepage": "https://github.com/FinaticORG/FinaticServerSDK-Node#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^24.5.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.1.3",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b",
  "workspaces": [
    "demo-app"
  ]
}
