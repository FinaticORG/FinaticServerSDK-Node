{
  "name": "@finatic/server-node",
  "version": "0.9.14",
  "description": "Node.js SDK for Finatic Server API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c && npm run build:types",
    "build:watch": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --no-warn-ignored",
    "lint:fix": "eslint src/**/*.ts --fix --no-warn-ignored",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && NODE_OPTIONS=--max-old-space-size=8192 npm run build",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly --declaration || (echo 'Type errors in generated files (non-blocking)' && exit 0)",
    "test:imports": "npm run build && node test-imports.cjs && node test-imports.mjs",
    "type:check": "tsc --noEmit",
    "syntax:check": "eslint src/**/*.ts --max-warnings 0 --no-warn-ignored",
    "syntax:fix": "eslint src/**/*.ts --fix --no-warn-ignored",
    "import:check": "tsc --noEmit --skipLibCheck",
    "quality:check": "npm run format:check && npm run lint && npm run type:check && npm run build",
    "quality:fix": "npm run format:fix && (npm run lint:fix || true) && npm run build",
    "dev": "yarn build:watch",
    "demo:dev": "yarn --cwd ../../../demoapps/server-node/demo-app dev",
    "demo:build": "yarn --cwd ../../../demoapps/server-node/demo-app build",
    "demo:start": "yarn --cwd ../../../demoapps/server-node/demo-app start"
  },
  "keywords": [
    "finatic",
    "trading",
    "finance",
    "api",
    "sdk",
    "nodejs",
    "typescript"
  ],
  "author": {
    "name": "Finatic",
    "email": "support@finatic.dev"
  },
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/FinaticORG/FinaticServerSDK-Node.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "node-cache": "^5.1.2",
    "p-retry": "^7.1.0",
    "pino": "^10.1.0",
    "undici": "^7.16.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.5.0",
    "@types/node-cache": "^4.2.5",
    "@types/pino": "^7.0.5",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.1.3",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.3.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.1"
  },
  "type": "module",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/FinaticORG/FinaticServerSDK-Node/issues"
  },
  "homepage": "https://github.com/FinaticORG/FinaticServerSDK-Node#readme",
  "packageManager": "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b"
}
